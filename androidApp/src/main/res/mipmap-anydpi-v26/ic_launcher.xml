<?xml version="1.0" encoding="utf-8"?>
<!--
  The -v26 qualifier stays even though minSdk is 26 and lint calls it obsolete: AAPT2 will not
  resolve an adaptive icon out of a plain -anydpi folder ("resource mipmap/ic_launcher not found"),
  so dropping the qualifier breaks the build. Verified, not cargo-culted.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
