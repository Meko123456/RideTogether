<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Location while the ride is running, and nothing more.

      ACCESS_BACKGROUND_LOCATION is deliberately absent: the ride runs in a foreground service of
      type "location" started from a visible activity, which covers the whole need on the
      while-in-use grant. Requesting the restricted permission would mean a Play declaration form
      and a demo video for capability the app does not use. See docs/PLAY_LOCATION_COMPLIANCE.md.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!--
      Declared because Android 12+ requires it alongside FINE: the system dialog offers the rider
      "Precise" or "Approximate", and an app that declares only FINE has its request refused when
      they choose Approximate. The app cannot *use* approximate location — a 1-3 km error tells
      you nothing about a 1.5 km gap — so it asks for both, and says so plainly when only the
      approximate grant comes back rather than silently drawing nonsense on the map.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.RideTogether">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.RideTogether">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Ride invites travel as ridetogether://join/<CODE> (spec 2.1). autoVerify is off
              because this is a private scheme, not an https App Link — there is no domain to
              verify against, and a rider tapping an invite in a chat app should land here.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ridetogether" android:host="join" />
            </intent-filter>
        </activity>
        <service
            android:name=".location.RideLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
